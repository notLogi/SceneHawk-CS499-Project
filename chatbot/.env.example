# Copy this file to .env and fill in your own keys.
#   cp .env.example .env      (or copy it in your file explorer)
# .env is gitignored, so your keys stay private.

# OpenAI key - embeds queries for the chat.py / load_chroma.py search step.
EMBED_API_KEY=
# Requesty key - generates the written chat answers (chat.py / server.py).
REQUESTY_API_KEY=
# TMDB key - fetches raw film data (tmdb_to_rag_metadata.py).
TMDB_API_KEY=

# Optional overrides:
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# REQUESTY_CHAT_MODEL=novita/ling-3.1-flash   # model that writes the recommendation
