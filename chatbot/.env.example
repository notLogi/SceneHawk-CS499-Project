# Copy this file to .env and fill in your own keys.
#   cp .env.example .env      (or copy it in your file explorer)
# .env is gitignored, so your keys stay private.

# OpenAI key - embeds queries for the chat.py / load_chroma.py search step.
EMBED_API_KEY=
# Requesty key - enriches films (enrich_films.py) and generates chat answers (chat.py).
REQUESTY_API_KEY=

# Optional overrides:
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_MODEL=text-embedding-3-small
# REQUESTY_MODEL=google/gemma-4-31b-it
