# Copy this file to .env.local for local dev, or set the same keys in the
# Vercel dashboard (Project > Settings > Environment Variables) for deploys.
# Everything here is OPTIONAL — the app runs with no keys, degrading to
# deterministic fallbacks (see AGENTS.md).

# --- Chatbot sidecar (the /chat page + /api/chat proxy) ---
# URL of the Python FastAPI chatbot service (the scenehawk-cs499 repo).
# Local dev: leave unset — the proxy defaults to http://127.0.0.1:8000.
# Production: set to the deployed service URL, e.g. your Render app.
CHATBOT_URL=https://scenehawk-chatbot.onrender.com

# --- In-app comparison pipelines (/search), per AGENTS.md ---
# FILM_STORE=local        # local JSON corpus (default) | firestore
# RETRIEVER=bm25          # bm25 (default) | embedding (needs OPENAI_API_KEY)
# OPENAI_API_KEY=         # enables LLM interpretation/explanations + embeddings

# --- Site metadata ---
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
